{
  "name": "disaster-relief-fund",
  "version": "1.0.0",
  "private": true,
  "description": "One Solidity contract for one simulated flood relief campaign, with a web app that runs it in the browser or on Sepolia through MetaMask.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "vite --port 5174",
    "compile": "node scripts/compile.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/compile.mjs --check && tsc --noEmit && vite build && vite build --mode single && node scripts/finish-single.mjs",
    "preview": "vite preview --port 5174",
    "build:artifact": "node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "@fontsource-variable/overpass": "5.3.0",
    "@fontsource/overpass-mono": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "9.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.58.4"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "solc": "0.8.30",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.1"
  }
}
